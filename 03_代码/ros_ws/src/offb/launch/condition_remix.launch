<launch>

	<!--  全局摄像头开启变量，默认关闭    -->
	<arg name="control" default="false"/>
        <arg name="desire_z"  type="double" value="0.5"/>
        <arg name="change" type="double" value="0.05" />
        <arg name="Baudrate" type="int" value="9600"/>
	<arg name="throw_serial_port"  type="string" value="/dev/arduino"/>
        
	<!--                            无人机飞行中的期望高度                                           -->
        <!--                                        持续向飞控发送点                                                                           -->
        <node  name = "send_info_node" pkg = "offb" type = "send_info_node" output = "screen"> </node>
         <!--                                     显示无人机的状态以及速度                               -->
        <node  name = "showinfo_node" pkg = "offb" type = "showinfo_node" output = "screen" launch-prefix="gnome-terminal --window --"> </node>
        
 	<!--                      打开电脑自带摄像头                                                  -->
        <node pkg="offb" type="cam.py" name="cam_node" respawn="false" />
	<!--                                      识别圆心并存储坐标                                                  -->
	<node pkg="offb" type="targetring_write.py" name="target_node" respawn="false" output = "screen" launch-prefix="gnome-terminal --window --" />	
</launch>
